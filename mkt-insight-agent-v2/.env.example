# .env.example — template, safe to commit. Copy to .env and fill real values.
# IAM credentials do NOT go here — see .greennode.json or env vars (§4.0).

# --- Database (shared local + prod) ---
MKT_DATABASE__URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/mkt_insight

# --- LLM ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=
LLM_JUDGE_MODEL=

# --- App ---
APP_PROFILE=local
LOG_LEVEL=info
MKT_ADMIN__TOKEN=
